{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "shell:allow-kill",
    "os:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "defaceWithAudio",
          "cmd": "deface",
          "args": [
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" }
          ]
        },
        {
          "name": "defaceWithoutAudio",
          "cmd": "deface",
          "args": [
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" },
            { "validator": ".*" }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "deface",
          "cmd": "deface",
          "args": [
            { "validator": ".*" }
          ]
        }
      ]
    },
    "shell:allow-open",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com"
        }
      ]
    }
  ]
}